# Database Configuration
DB_DRIVER=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iot_monitoring
DB_USER=postgres
DB_PASSWORD=your_password_here

# MongoDB Configuration
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=iot_monitoring
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin

# JWT Security Settings
# IMPORTANT: Change this secret key in production! Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24

# API Security
API_KEY=your_api_key_here
SECRET_KEY=your_secret_key_here

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Server Configuration
PORT=8000
ENVIRONMENT=development
